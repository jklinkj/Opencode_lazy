{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/opencode-installer/download-manifest.schema.json",
  "title": "Download Manifest",
  "type": "object",
  "required": ["artifacts"],
  "properties": {
    "policyVersion": {
      "type": "string"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["fileName", "sha256", "sources"],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "archiveType": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["url"],
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "priority": {
                  "type": "integer"
                },
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}